// Original corpus. The last two sections follow arguments in proof order.
#let corpus = (
  // Algebra, notation and intentional stress cases.
  literal: $x$,
  integer: $12 + 24 = 36$,
  signs: $-x + y - (-z)$,
  adjacent: $a + -b$,
  nested-sign: $(-a) - (-b)$,
  tuple: $(a+b, c+d, e-f)$,
  identity: $a + 0 = a$,
  imply: $a = b => a + c = b + c$,
  lone-arrow: $a => b$,
  explicit-gap: $x #h(3pt) + y = z$,
  soft-gap: $x #h(10%) + y$,
  opaque: $x + #box[?] = y$,
  wrapped: $bold(x + y) = z$,
  text: $x > 0 "for all" x in RR$,
  decimal: $0.25 + 0.75 = 1$,
  unknown-glyph: $a ⟿ b + c$,
  custom-class: $x class("relation", <) y - z$,
  smid: $lr({x in RR mid(|) x^2 < 2})$,
  equal-branches: $frac(a+b,a+b)$,
  labelled-gap: $x + #[#math.frac($a+b$.body, $c-d$.body)<part>] - z$,
  fraction-style: $frac(style: "horizontal", a+b, c-d) = (a+b)/(c-d)$,
  horizontal-native: $frac(style: "horizontal", a+b, c-d)$,
  wrapped-fence: $sum lr(abs(x)) + y$,
  aside-width: $a + frac((a+b),(c+d))$,
  attached-sign: $a +_i b$,
  punctuation-fence: $(x,)$,
  fence-space: $x | y$,
  vertical-bar: $abs(-x) + abs(y)$,
  align: $ x + y &= 2x \ y &= x $,
  // Linear algebra. Gram–Schmidt, change of basis, normal equations, spectral theory.
  mat-vec: $A x = mat(a+b,-c;d,e-f) vec(x_1,x_2)$,
  mat-delim: $sum mat(delim: #none, a+b,c;d,e)$,
  dot-product: $chevron.l x, y chevron.r = sum_(i=1)^n x_i y_i$,
  projection: $p_u(v) = (chevron.l v,u chevron.r / chevron.l u,u chevron.r) u$,
  gram: $u_k = v_k - sum_(j=1)^(k-1) (chevron.l v_k,u_j chevron.r / chevron.l u_j,u_j chevron.r) u_j$,
  norm: $norm(x+y)^2 = norm(x)^2 + 2 chevron.l x,y chevron.r + norm(y)^2$,
  matrix-product: $(A B)_(i j) = sum_(k=1)^r a_(i k) b_(k j)$,
  attached-fence: $sum^n (a+b)^2 + z$,
  change-basis: $B = P^(-1) A P => B^k = P^(-1) A^k P$,
  linearity: $A (alpha u + beta v) = alpha A u + beta A v$,
  adjoint: $chevron.l A x, y chevron.r = chevron.l x,A^* y chevron.r$,
  normal-equations: $A^* A x = A^* b$,
  spectrum: $A v = lambda v => A^2 v = lambda^2 v$,
  rayleigh: $lambda_"max" = max_(norm(x)=1) chevron.l A x,x chevron.r$,
  rank-nullity: $dim ker(A) + dim im(A) = dim V$,
  determinant: $det(mat(a,b;c,d)) = a d - b c$,
  piecewise-linear: $T(x)=cases(x quad x>=0, -x quad x<0)$,
  large-trigger: $sum_i^n = product_j^m (a+b)$,
  // Analysis. Bounds, difference quotients, convergence, integration and series.
  derivative: $f'(x) = lim_(h -> 0) (f(x+h)-f(x))/h$,
  continuity: $forall epsilon > 0, exists delta > 0, abs(x-a) < delta => abs(f(x)-f(a)) < epsilon$,
  triangle: $abs(f_n(x)-f(x)) <= abs(f_n(x)-g(x)) + abs(g(x)-f(x))$,
  uniform: $sup_(x in [a,b]) abs(f_n(x)-f(x)) -> 0$,
  bound: $0 <= x / (1+x^2) <= 1/2$,
  compactness: $x_(n_k) -> x in [a,b]$,
  cauchy: $forall epsilon>0, exists N, forall m,n>=N, abs(x_n-x_m)<epsilon$,
  median: $M_n = (sum_(i=1)^n w_i x_i) / (sum_(i=1)^n w_i)$,
  riemann: $integral_a^b f(x) dif x = lim_(n -> oo) sum_(i=1)^n f(x_i^*) Delta x_i$,
  integration-parts: $integral_a^b u v' dif x = lr([u v]_a^b) - integral_a^b u' v dif x$,
  geometric: $sum_(k=0)^n r^k = (1-r^(n+1))/(1-r)$,
  alternating: $sum_(k=1)^oo (-1)^(k+1) / k = ln(2)$,
  bernoulli: $(1+x)^n >= 1+n x$,
  root: $sqrt(x^2+y^2) <= abs(x)+abs(y)$,
  convergence: $lim_(n -> oo) integral_0^1 f_n(x) dif x = integral_0^1 f(x) dif x$,
  taylor: $f(x+h) = f(x) + h f'(x) + (h^2)/2 f''(x) + o(h^2)$,
  difference: $a^(b+c) - a^(b-c)$,
  limits-two: $lim_(x -> 0) (sin x)/x = 1$,
  open-set: $U = union_(n=1)^oo (-1+1/n, 1-1/n)$,
  accent: $hat(f)(xi) = integral_RR f(x) e^(-2 pi i x xi) dif x$,
  set-convergence: $A = inter_(n=1)^oo union_(k=n)^oo A_k$,
  scope-style: $frac(style: "skewed", x+y, w-z) + 1$,
)
